# Copy this file to .env and fill in your real values. Never commit .env.

# Base URL of the backend API (see ../server)
VITE_API_URL=http://localhost:4000/api

# Stripe publishable key, from https://dashboard.stripe.com/test/apikeys (starts with pk_test_...)
# Optional: leave blank to skip real card entry — checkout will still work, orders are
# just created with payment marked "pending" instead of a real Stripe charge.
VITE_STRIPE_PUBLISHABLE_KEY=
