# Copy this file to .env and fill in your real values. Never commit .env.

# MongoDB Atlas connection string (see README for how to get this)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/kilnandgrain?

# Any long random string — used to sign login sessions (JWTs)
JWT_SECRET=replace_with_a_long_random_string

# Stripe secret key, from https://dashboard.stripe.com/test/apikeys (starts with sk_test_...)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend's URL)
CLIENT_ORIGIN=http://localhost:5173
